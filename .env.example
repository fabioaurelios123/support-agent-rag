# Which LLM drives the agent: auto | mock | anthropic | openai | ollama
# "auto" uses Anthropic if ANTHROPIC_API_KEY is set, then OpenAI, otherwise the offline mock.
LLM_PROVIDER=auto

# Anthropic (default when a key is present)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side refusal fallback; set to "off" to disable
ANTHROPIC_FALLBACKS=default

# OpenAI or any OpenAI-compatible endpoint (Together, Groq, vLLM, LM Studio...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Ollama (local, no key): LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Retrieval: auto | none | openai  ("auto" turns on hybrid BM25 + embeddings when OPENAI_API_KEY is set)
EMBEDDINGS=auto
EMBEDDING_MODEL=text-embedding-3-small

# Paths (defaults: ./knowledge_base and ./data/support.db)
KB_DIR=
DB_PATH=
